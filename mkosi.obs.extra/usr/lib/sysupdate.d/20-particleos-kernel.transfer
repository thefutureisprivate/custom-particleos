[Transfer]
ProtectVersion=%A

[Source]
Type=url-file
Path=https://download.opensuse.org/repositories/home:/thefutureisprivate/%o_%w_images/
MatchPattern=%M_@v_%a.efi

[Target]
Type=regular-file
Path=/EFI/Linux
PathRelativeTo=boot
MatchPattern=%M-@v_%a+@l-@d.efi \
  %M-@v_%a+@l.efi \
  %M-@v_%a.efi
Mode=0644
TriesLeft=3
TriesDone=0
InstancesMax=2
