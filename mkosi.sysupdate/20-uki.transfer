# SPDX-License-Identifier: LGPL-2.1-or-later

[Transfer]
ProtectVersion=%A

[Source]
Type=regular-file
Path=/
PathRelativeTo=explicit
MatchPattern=%M_@v_%a.efi

[Target]
Type=regular-file
Path=/EFI/Linux
PathRelativeTo=boot
MatchPattern=%M-@v_%a+@l-@d.efi \
             %M-@v_%a+@l.efi \
             %M-@v_%a.efi \
             %M-@v+@l-@d.efi \
             %M-@v+@l.efi \
             %M-@v.efi
Mode=0600
TriesLeft=3
TriesDone=0
InstancesMax=2
