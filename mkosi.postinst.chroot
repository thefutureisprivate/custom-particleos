#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
set -euo pipefail

authselect select local
authselect enable-feature with-systemd-homed

# systemd-pull verifies OBS's signed SHA256SUMS with this exclusive project
# key. Its gpg --keyring interface requires the binary OpenPGP form, so dearmor
# the pinned repository key before mkosi's SELinux relabel pass and replace the
# generic key shipped by systemd-container.
gpg --batch --yes --dearmor \
    --output /usr/lib/systemd/import-pubring.pgp \
    /usr/lib/particleos/sysupdate-key-source/particleos-obs-pubkey.gpg
chmod 0644 /usr/lib/systemd/import-pubring.pgp

# mkosi.extra installs the final runtime preload before this script runs.
# SELinux policy compilation is memory-intensive and must use the system
# allocator inside the constrained OBS build VM. Restore the preload even if
# policy installation fails so a partially produced tree cannot lose it.
preload=/etc/ld.so.preload
preload_build_backup=/etc/ld.so.preload.particleos-build
restore_preload() {
    if [[ -f "$preload_build_backup" ]]; then
        mv "$preload_build_backup" "$preload"
    fi
}
trap restore_preload EXIT
if [[ -f "$preload" ]]; then
    mv "$preload" "$preload_build_backup"
fi

# Fail closed if a future kernel introduces an SELinux permission which the
# installed Fedora policy does not yet understand.
if ! grep -qx 'handle-unknown=deny' /etc/selinux/semanage.conf; then
    printf '\n# ParticleOS fails closed on permissions missing from policy.\nhandle-unknown=deny\n' \
        >>/etc/selinux/semanage.conf
fi

setsebool -P deny_ptrace=on
# container_allow_ptrace was removed from Fedora's SELinux policy. Keep it
# disabled on policy versions that still define it without making newer
# policy installations fail.
if getsebool container_allow_ptrace >/dev/null 2>&1; then
    setsebool -P container_allow_ptrace=off
fi
semodule -X 300 -i \
    /usr/lib/particleos/selinux/secureblue_harden_userns.cil \
    /usr/lib/particleos/selinux/secureblue_socket_utils.cil \
    /usr/lib/particleos/selinux/secureblue_deny_alg_sockets.cil \
    /usr/lib/particleos/selinux/secureblue_deny_ipsec_sockets.cil \
    /usr/lib/particleos/selinux/secureblue_deny_obscure_sockets.cil \
    /usr/lib/particleos/selinux/secureblue_deny_packet_radio_sockets.cil \
    /usr/lib/particleos/selinux/particleos_homed_login.cil
restore_preload
trap - EXIT

# Retain the administration tools for run0 and recovery, but do not let an
# unprivileged caller cross the root boundary through util-linux SUID mode.
chmod 0755 /usr/bin/mount /usr/bin/umount

# The allocator packages ship shared objects with a meaningless setuid mode
# bit. Shared libraries never need a privilege transition; normalize them so
# privileged-file scanners report only the two required PAM/polkit helpers.
find /usr/lib64 -xdev -type f \
    \( -name 'libhardened_malloc*.so' -o -name 'libno_rlimit_as.so' \) \
    -exec chmod 0644 {} +

if [[ -d /etc/pam.d ]]; then
    find /etc/pam.d -mindepth 1 -exec mv {} /usr/lib/pam.d \;
    rmdir /etc/pam.d
fi

# pam_unix can validate the shadow hash exported by systemd-homed but cannot
# activate the home. Run pam_systemd_home first so it receives the password.
for pam_stack in /usr/lib/pam.d/system-auth /usr/lib/pam.d/password-auth; do
    sed --in-place \
        '/^auth[[:space:]].*pam_systemd_home\.so[[:space:]]*$/d' "$pam_stack"
    sed --in-place \
        '/^auth[[:space:]].*pam_unix\.so/i auth        sufficient                                   pam_systemd_home.so' \
        "$pam_stack"
done

# Remove obsolete entries from the PAM stack.
find /usr/lib/pam.d/ -mindepth 1 -exec sed --in-place '/pam_shells.so/d' {} \;
find /usr/lib/pam.d/ -mindepth 1 -exec sed --in-place '/pam_securetty.so/d' {} \;

# Fedora ships the systemd-userdb SSH drop-in disabled as an example.
if [[ -f /usr/lib/tmpfiles.d/20-systemd-userdb.conf.example ]]; then
    ln --symbolic 20-systemd-userdb.conf.example /usr/lib/tmpfiles.d/20-systemd-userdb.conf
fi

# Keep the installed host headless.
ln --symbolic --force multi-user.target /usr/lib/systemd/system/default.target

# systemd creates this private runtime directory before ExecStartPre. Mirror
# that lifecycle only for the build-time configuration test.
install --directory --mode=0700 /run/nginx
nginx -e stderr -t -c /usr/lib/particleos/nginx/nginx.conf
rm --force /run/nginx/nginx.pid
rmdir /run/nginx

# Give the image a distinct identity without changing Fedora's package identity.
(
    # shellcheck source=/dev/null
    . /usr/lib/os-release
    cat >/usr/lib/os-release <<EOF
NAME="ParticleOS Webserver (Fedora Flavour)"
ID="$ID"
ID_LIKE="particleos-$ID"
PRETTY_NAME="ParticleOS Webserver/$NAME $VERSION"
FANCY_NAME="ParticleOS Webserver/$NAME $VERSION"
VERSION="$VERSION"
VERSION_ID="$VERSION_ID"
ANSI_COLOR="38:2:252:186:3;1;49"
ANSI_COLOR_REVERSE="48;2;252:186:3;1;30"
DEFAULT_HOSTNAME="particle-web-????-????"
HOME_URL="https://github.com/systemd/particleos/"
EOF

    cat >/usr/lib/issue <<EOF
ParticleOS Webserver/$NAME Flavour $VERSION
Kernel \r on an \m (\l)

EOF
)
