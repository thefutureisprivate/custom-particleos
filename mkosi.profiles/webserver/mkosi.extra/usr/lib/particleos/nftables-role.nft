# SPDX-License-Identifier: LGPL-2.1-or-later

# Connection-count state is tied to conntrack lifetime. Do not add a timeout:
# nftables connlimits require dynamic sets without one.
set web_tcp_conn4 {
    type ipv4_addr
    size 4096
    flags dynamic
}

set web_tcp_conn6 {
    type ipv6_addr
    size 4096
    flags dynamic
}

chain role_prerouting_raw {
    tcp flags & (fin | syn | rst | ack) == syn tcp dport { 80, 443 } accept
    udp dport 443 accept
}

chain role_input {
    meta nfproto ipv4 tcp dport { 80, 443 } ct state new add @web_tcp_conn4 { ip saddr ct count over 64 } counter drop
    meta nfproto ipv6 tcp dport { 80, 443 } ct state new add @web_tcp_conn6 { ip6 saddr ct count over 64 } counter drop
    tcp dport { 80, 443 } ct state new ct count over 2048 counter drop
    meta nfproto ipv4 tcp dport { 80, 443 } ct state new meter web_tcp4 size 65535 { ip saddr timeout 1m limit rate over 8/second burst 32 packets } counter drop
    meta nfproto ipv6 tcp dport { 80, 443 } ct state new meter web_tcp6 size 65535 { ip6 saddr timeout 1m limit rate over 8/second burst 32 packets } counter drop
    tcp dport { 80, 443 } ct state new limit rate over 128/second burst 256 packets counter drop
    tcp dport { 80, 443 } ct state new accept

    meta nfproto ipv4 udp dport 443 ct state new meter web_quic4 size 65535 { ip saddr timeout 1m limit rate over 32/second burst 64 packets } counter drop
    meta nfproto ipv6 udp dport 443 ct state new meter web_quic6 size 65535 { ip6 saddr timeout 1m limit rate over 32/second burst 64 packets } counter drop
    udp dport 443 ct state new limit rate over 256/second burst 512 packets counter drop
    udp dport 443 ct state new accept
}

chain role_output {
    meta skuid certbot tcp dport { 80, 443 } ct state new limit rate 8/second burst 16 packets accept
}
