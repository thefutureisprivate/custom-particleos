[Unit]
Description=Watch for validated Certbot deployment requests
# Path units order before paths.target. Keep nginx dependencies on the
# triggered service so this watcher cannot form a paths.target/basic.target
# ordering cycle during boot.

[Path]
PathExists=/run/particleos-certbot/reload-request
Unit=particleos-nginx-reload.service

[Install]
WantedBy=multi-user.target
