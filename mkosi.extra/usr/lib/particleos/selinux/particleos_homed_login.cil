; SPDX-License-Identifier: LGPL-2.1-or-later

; Fedora 44 login, PAM, polkit, and SSH domains query systemd-userdbd while
; resolving systemd-homed users. The base policy permits connecting and
; writing to the Varlink socket but omits the inode read operation used by the
; current userdb client.
(block particleos_homed_login
  (allow .local_login_t .systemd_userdbd_runtime_t (sock_file (read)))
  (allow .chkpwd_t .systemd_userdbd_runtime_t (sock_file (read)))
  (allow .policykit_t .systemd_userdbd_runtime_t (sock_file (read)))
  (allow .policykit_auth_t .systemd_userdbd_runtime_t (sock_file (read)))
  (allow .sshd_session_t .systemd_userdbd_runtime_t (sock_file (read)))

  ; pam_systemd_home in polkit's private authentication helper talks directly
  ; to homed and writes the already-open suspend-inhibition pipe returned by
  ; the daemon. Grant only those message directions and that pipe operation.
  (allow .policykit_auth_t .systemd_homed_t (dbus (send_msg)))
  (allow .systemd_homed_t .policykit_auth_t (dbus (send_msg)))
  (allow .policykit_auth_t .systemd_homed_runtime_pipe_t (fifo_file (write))))
