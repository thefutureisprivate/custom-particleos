; SPDX-License-Identifier: LGPL-2.1-or-later

; ParticleOS mounts the authenticated /usr filesystem nosuid. Fedora already
; permits several systemd and web-facing services to enter their confined
; domains from such a mount, but does not cover every daemon shipped here.
; Grant only the missing transitions required during normal boot and service
; activation. Do not grant no-new-privileges or runtime-file access to init_t.
(block particleos_nosuid_daemon_transitions
  (allow .init_t .udev_t (process2 (nosuid_transition)))
  (allow .init_t .system_dbusd_t (process2 (nosuid_transition)))
  (allow .init_t .ldconfig_t (process2 (nosuid_transition)))
  (allow .init_t .iptables_t (process2 (nosuid_transition)))
  (allow .init_t .sshd_keygen_t (process2 (nosuid_transition)))
  (allow .init_t .chronyd_t (process2 (nosuid_transition)))

  ; Preserve the existing Fedora transitions for helpers launched by the
  ; confined boot services once /usr is mounted nosuid. These are chained
  ; transitions, so granting init_t access alone is insufficient.
  (allow .udev_t .systemd_sysctl_t (process2 (nosuid_transition)))
  (allow .udev_t .lvm_t (process2 (nosuid_transition)))
  (allow .sshd_keygen_t .ssh_keygen_t (process2 (nosuid_transition)))
  (allow .sshd_keygen_t .setfiles_t (process2 (nosuid_transition)))
  (allow .systemd_homed_t .systemd_homework_t (process2 (nosuid_transition)))
  (allow .getty_t .local_login_t (process2 (nosuid_transition)))

  ; A homed login starts the per-user manager and then enters the Fedora user
  ; domain. OpenSSH additionally re-executes through sshd_session_t. Fedora
  ; already defines and permits these transitions on ordinary mounts.
  (allow .init_t .unconfined_t (process2 (nosuid_transition)))
  (allow .local_login_t .unconfined_t (process2 (nosuid_transition)))
  (allow .sshd_t .sshd_session_t (process2 (nosuid_transition)))
  (allow .sshd_session_t .unconfined_t (process2 (nosuid_transition)))

  ; run0 authenticates through polkit's private PAM helper. Fedora already
  ; defines the confined chkpwd transition both for that helper and for PID 1's
  ; transient-service PAM account check. Preserve those same password checks
  ; from the nosuid /usr mount.
  (allow .policykit_auth_t .chkpwd_t (process2 (nosuid_transition)))
  (allow .init_t .chkpwd_t (process2 (nosuid_transition))))
