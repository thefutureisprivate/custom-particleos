#!/usr/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
set -euo pipefail

export LC_ALL=C
export SYSTEMD_COLORS=0

readonly state_directory=/var/lib/particleos
readonly marker="$state_directory/admin-provisioned"

key_file=
key_blob_file=
retrieved_key_file=

valid_username() {
    [[ $1 =~ ^[a-z][a-z0-9_-]{0,30}$ ]]
}

valid_ed25519_key_file() {
    local file=$1
    local key_type=
    local key_payload=
    local blob_hex=

    read -r key_type key_payload _ <"$file"
    [[ $key_type == ssh-ed25519 && -n $key_payload ]] || return 1
    printf '%s' "$key_payload" | base64 --decode >"$key_blob_file" 2>/dev/null || return 1
    blob_hex=$(od --address-radix=n --format=x1 --output-duplicates "$key_blob_file" |
        tr --delete '[:space:]')

    # RFC 8709: string "ssh-ed25519", followed by one 32-byte public key.
    [[ $blob_hex =~ ^0000000b7373682d6564323535313900000020[[:xdigit:]]{64}$ ]]
}

cleanup() {
    local status=$?

    trap - EXIT
    [[ -z $key_file ]] || rm --force -- "$key_file"
    [[ -z $key_blob_file ]] || rm --force -- "$key_blob_file"
    [[ -z $retrieved_key_file ]] || rm --force -- "$retrieved_key_file"
    exit "$status"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

[[ ! -e $marker ]] || exit 0
[[ -t 0 && -t 1 ]] || {
    echo "ParticleOS administrator provisioning requires the system console." >&2
    exit 1
}

install --directory --mode=0700 --owner=root --group=root "$state_directory"
key_file=$(mktemp /run/particleos-admin-key.XXXXXX)
key_blob_file=$(mktemp /run/particleos-admin-key-blob.XXXXXX)
retrieved_key_file=$(mktemp /run/particleos-admin-key-retrieved.XXXXXX)
chmod 0600 "$key_file" "$key_blob_file" "$retrieved_key_file"

verify_account() {
    local account=$1
    local expected_key_file=${2:-}
    local account_groups=
    local expected_type=
    local expected_payload=
    local retrieved_type=
    local retrieved_payload=

    valid_username "$account" || return 1
    homectl inspect "$account" >/dev/null || return 1
    [[ -e /home/"$account".home ]] || return 1

    account_groups=" $(id --name --groups "$account") "
    [[ $account_groups == *' wheel '* ]] || return 1
    [[ $account_groups == *' systemd-journal '* ]] || return 1

    userdbctl ssh-authorized-keys "$account" >"$retrieved_key_file"
    valid_ed25519_key_file "$retrieved_key_file" || return 1
    if [[ -n $expected_key_file ]]; then
        read -r expected_type expected_payload _ <"$expected_key_file"
        read -r retrieved_type retrieved_payload _ <"$retrieved_key_file"
        [[ $expected_type == "$retrieved_type" && $expected_payload == "$retrieved_payload" ]]
    fi
}

# homectl creates the image and signed identity as one operation. If power was
# lost after that transaction but before our marker rename, accept exactly one
# fully provisioned homed administrator instead of creating a second account.
mapfile -t existing_accounts < <(
    homectl list --no-legend --no-pager | awk 'NF { print $1 }'
)
if ((${#existing_accounts[@]} > 0)); then
    if ((${#existing_accounts[@]} != 1)) || ! verify_account "${existing_accounts[0]}"; then
        echo "Existing homed accounts require manual console recovery; refusing automatic provisioning." >&2
        exit 1
    fi

    printf '%s\n' "${existing_accounts[0]}" >"$state_directory/admin-provisioned.new"
    chmod 0600 "$state_directory/admin-provisioned.new"
    mv --force --no-target-directory \
        "$state_directory/admin-provisioned.new" "$marker"
    exit 0
fi

printf '\nParticleOS administrator provisioning\n'
printf 'The root password was configured separately by systemd-firstboot.\n'
printf 'This password encrypts the user home and authenticates console and run0 access.\n'
printf 'SSH first verifies the Ed25519 key, then asks for this password to unlock the home.\n\n'

username=
while true; do
    read -r -p 'Administrator username: ' username
    if ! valid_username "$username"; then
        echo "Use 1-31 lowercase letters, digits, underscores, or hyphens; start with a letter." >&2
        continue
    fi
    if getent passwd "$username" >/dev/null || getent group "$username" >/dev/null; then
        echo "That account or group already exists." >&2
        continue
    fi
    break
done

authorized_key=
while true; do
    read -r -p 'Administrator Ed25519 public key: ' authorized_key
    if [[ ! $authorized_key =~ ^ssh-ed25519[[:space:]]+[A-Za-z0-9+/]+={0,3}([[:space:]][^[:cntrl:]]*)?$ ]]; then
        echo "Enter one raw ssh-ed25519 public key without key-option prefixes." >&2
        continue
    fi
    printf '%s\n' "$authorized_key" >"$key_file"
    if valid_ed25519_key_file "$key_file"; then
        break
    fi
    echo "The Ed25519 public key is malformed." >&2
done
authorized_key=

printf 'The Ed25519 SSH key is valid and will be stored in the signed user record.\n\n'
printf 'systemd-homed will now ask for the administrator password twice.\n'

homectl create "$username" \
    --member-of=wheel,systemd-journal \
    --storage=luks \
    --fs-type=btrfs \
    --disk-size=90% \
    --auto-resize-mode=off \
    --luks-discard=yes \
    --nosuid=yes \
    --nodev=yes \
    --noexec=no \
    --enforce-password-policy=yes \
    --ssh-authorized-keys=@"$key_file"

verify_account "$username" "$key_file" || {
    echo "The homed account or its userdb SSH key failed verification." >&2
    exit 1
}

printf '%s\n' "$username" >"$state_directory/admin-provisioned.new"
chmod 0600 "$state_directory/admin-provisioned.new"
mv --force --no-target-directory \
    "$state_directory/admin-provisioned.new" "$marker"

printf '\nAdministrator %s is ready.\n' "$username"
