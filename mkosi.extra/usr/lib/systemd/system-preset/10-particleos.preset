# SPDX-License-Identifier: LGPL-2.1-or-later

# Headless networking.
enable systemd-networkd.service
# A VPS can be healthy while its provider network is temporarily unavailable.
# Mail and web daemons bind local/wildcard sockets without carrier, so boot and
# rollback health must never wait for an external network.
disable systemd-networkd-wait-online.service
enable systemd-resolved.service
disable NetworkManager.service
disable NetworkManager-wait-online.service

# Authenticated time replaces systemd-timesyncd.
disable systemd-timesyncd.service
enable chronyd.service
disable chrony-wait.service

# Fail closed: SSH requires the firewall.
enable nftables.service
enable particleos-module-lockdown.service

# SSH is socket activated, key-only, and blocked by nftables until allowlisted.
disable sshd.service
enable sshd.socket

# First-boot administration and core maintenance.
disable authselect-apply-changes.service
enable systemd-homed-firstboot.service
# Authentication helpers run as root through a private AF_UNIX socket instead
# of gaining privilege from executable file mode bits.
enable polkit-agent-helper.socket
enable preset-global.service
enable systemd-oomd.service
enable systemd-sysupdate-update.timer
enable systemd-sysupdate-reboot.timer
enable systemd-boot-check-no-failures.service
enable fstrim.timer

# systemd-container is installed only for systemd-pull. Its other units and
# binaries are removed after package installation.
disable machines.target
disable systemd-importd.socket
disable systemd-machined.socket
disable systemd-mountfsd.socket
disable systemd-nsresourced.socket

# Reduce unused local discovery and sensitive crash artifacts.
disable avahi-daemon.service
disable avahi-daemon.socket
disable debug-shell.service
