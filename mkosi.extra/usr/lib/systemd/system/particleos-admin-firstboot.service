[Unit]
Description=Provision the ParticleOS administrator
Documentation=https://github.com/thefutureisprivate/custom-particleos/
Requires=systemd-firstboot.service systemd-homed.service
After=home.mount local-fs.target systemd-firstboot.service systemd-homed.service systemd-tmpfiles-setup.service
Before=getty-pre.target sshd.socket systemd-user-sessions.service multi-user.target
# Retry after an interrupted first boot until the verified account marker is
# durable; ConditionFirstBoot= would strand a created home after a power loss.
ConditionPathExists=!/var/lib/particleos/admin-provisioned
RequiresMountsFor=/home /var/lib/particleos

[Service]
Type=oneshot
ExecStart=/usr/lib/particleos/admin-firstboot
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/console
TTYReset=yes
TimeoutStartSec=infinity
UMask=0077

CapabilityBoundingSet=
IPAddressDeny=any
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ReadWritePaths=/run /var/lib/particleos
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
