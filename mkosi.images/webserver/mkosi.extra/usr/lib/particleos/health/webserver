#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
set -euo pipefail

/usr/bin/nginx -e stderr -t -q -c /usr/lib/particleos/nginx/nginx.conf

# A successful configuration test does not prove the service is accepting
# requests. Probe only the local clear-text listener: TLS is intentionally not
# provisioned until the operator supplies a domain and obtains a certificate.
for ((attempt = 0; attempt < 30; attempt++)); do
    if exec 3<>/dev/tcp/127.0.0.1/80; then
        printf 'HEAD / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n' >&3
        IFS= read -r status <&3 || true
        exec 3>&- 3<&-
        if [[ $status == HTTP/* ]]; then
            exit 0
        fi
    fi
    sleep 1
done

echo "nginx did not return an HTTP response on 127.0.0.1:80" >&2
exit 1
