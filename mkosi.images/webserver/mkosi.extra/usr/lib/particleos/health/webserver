#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
set -euo pipefail

# nginx.service validates the configuration in ExecStartPre with the same
# capabilities and resource limits as the production master process. Repeating
# that test here would require this otherwise unprivileged health check to bind
# privileged listeners. Probe only the local clear-text listener instead: TLS
# is intentionally not provisioned until the operator supplies a domain and
# obtains a certificate.
for ((attempt = 0; attempt < 30; attempt++)); do
    if exec 3<>/dev/tcp/127.0.0.1/80; then
        printf 'HEAD / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n' >&3
        IFS= read -r status <&3 || true
        exec 3>&- 3<&-
        if [[ $status == HTTP/* ]]; then
            exit 0
        fi
    fi
    sleep 1
done

echo "nginx did not return an HTTP response on 127.0.0.1:80" >&2
exit 1
