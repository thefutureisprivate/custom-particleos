[Unit]
Description=Acquire and activate a compatible Stalwart service image
Documentation=file:/usr/share/doc/particleos/stalwart/IMAGE-UPDATES.md
Requires=nftables.service particleos-module-lockdown.service particleos-stalwart-image-setup.service
After=nftables.service particleos-module-lockdown.service particleos-stalwart-image-setup.service network.target

[Service]
Type=oneshot
ExecStart=/usr/lib/particleos/stalwart/image-manager update
NFTSet=cgroup:inet:particleos_filter:sysupdate_cgroups
LockPersonality=yes
MemoryDenyWriteExecute=yes
# systemd-sysupdate is labelled systemd_importd_exec_t and must transition out
# of init_t. SELinux does not grant nnp_transition for that domain.
NoNewPrivileges=no
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ReadWritePaths=/var/lib/particleos/stalwart
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
UMask=0077
