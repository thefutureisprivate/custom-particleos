# PostgreSQL initialization and role provisioning are hard dependencies of
# Stalwart. The bootstrap listener is loopback-reachable for setup and health
# checks but remains absent from the public nftables policy.
enable postgresql.service
enable particleos-stalwart-database.service
enable stalwart.service
enable particleos-mailserver-health.service
