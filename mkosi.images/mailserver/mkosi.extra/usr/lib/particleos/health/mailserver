#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
set -euo pipefail

tcp_connect() {
    local address=$1
    local port=$2

    exec 3<>"/dev/tcp/$address/$port"
    exec 3>&- 3<&-
}

webui_responds() {
    local address=$1
    local status

    exec 3<>"/dev/tcp/$address/8080"
    printf 'HEAD /admin HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n' >&3
    IFS= read -r status <&3 || true
    exec 3>&- 3<&-
    [[ $status =~ ^HTTP/[0-9.]+\ [23][0-9][0-9] ]]
}

database_ready=false
for ((attempt = 0; attempt < 60; attempt++)); do
    result="$(/usr/bin/psql --no-password --no-psqlrc \
        --host=/run/postgresql --username=stalwart --dbname=stalwart \
        --tuples-only --no-align --command='SELECT 1' 2>/dev/null || true)"
    if [[ $result == 1 ]]; then
        database_ready=true
        break
    fi
    sleep 1
done
if [[ $database_ready != true ]]; then
    echo 'Stalwart cannot authenticate to its local PostgreSQL database by peer identity' >&2
    exit 1
fi

dns_ready=false
for ((attempt = 0; attempt < 60; attempt++)); do
    if /usr/bin/resolvectl --cache=no --legend=no query cloudflare.com \
            >/dev/null 2>&1; then
        dns_ready=true
        break
    fi
    sleep 1
done
if [[ $dns_ready != true ]]; then
    echo 'strict systemd-resolved DNS-over-TLS/DNSSEC resolution is unavailable' >&2
    exit 1
fi

listeners_ready=false
for ((attempt = 0; attempt < 60; attempt++)); do
    listeners_ready=true
    for address in 127.0.0.1 ::1; do
        for port in 25 443 465 993; do
            if ! tcp_connect "$address" "$port" 2>/dev/null; then
                listeners_ready=false
            fi
        done
    done
    if [[ $listeners_ready == true ]]; then
        break
    fi
    sleep 1
done
if [[ $listeners_ready != true ]]; then
    echo 'Stalwart did not bind every required public listener on IPv4 and IPv6' >&2
    exit 1
fi

webui_ready=false
for ((attempt = 0; attempt < 60; attempt++)); do
    if webui_responds 127.0.0.1 2>/dev/null &&
            webui_responds ::1 2>/dev/null; then
        webui_ready=true
        break
    fi
    sleep 1
done
if [[ $webui_ready != true ]]; then
    echo 'Stalwart did not serve its packaged WebUI on the loopback bootstrap listener' >&2
    exit 1
fi

for address in 127.0.0.1 ::1; do
    for port in 110 143 587 995 4190; do
        if tcp_connect "$address" "$port" 2>/dev/null; then
            echo "forbidden plaintext, POP, or ManageSieve listener is active on $address:$port" >&2
            exit 1
        fi
    done
done
