; SPDX-License-Identifier: LGPL-2.1-or-later

; systemd-sysupdate executes systemd-pull directly for URL transfers. Keep the
; image manager itself networkless and transition only Fedora's labelled pull
; helper into the existing confined systemd_importd_t domain.
(type particleos_stalwart_managed_unit_t)
(roletype .object_r particleos_stalwart_managed_unit_t)
(typeattributeset .file_type (particleos_stalwart_managed_unit_t))
(typeattributeset .systemd_unit_file_type
  (particleos_stalwart_managed_unit_t))

(block particleos_stalwart_pull
  (allow .stalwart_image_manager_t .systemd_importd_exec_t
    (file (getattr open map read execute ioctl)))
  (allow .stalwart_image_manager_t .systemd_importd_t
    (process (transition)))
  (typetransition .stalwart_image_manager_t .systemd_importd_exec_t
    process .systemd_importd_t)

  ; particleos-stalwart-update.service sets both hardening properties. Permit
  ; the domain transition without weakening either service-level restriction.
  (allow .stalwart_image_manager_t .systemd_importd_t
    (process2 (nnp_transition nosuid_transition)))

  ; The pull helper and system bus return bounded command output through pipes
  ; created by the manager. Neither domain receives access to manager files.
  (allow .systemd_importd_t .stalwart_image_manager_t
    (fifo_file (getattr write)))
  (allow .systemd_importd_t .stalwart_image_manager_t
    (unix_dgram_socket (sendto)))
  (allow .system_dbusd_t .stalwart_image_manager_t
    (fifo_file (write)))

  ; systemd-sysupdate downloads into the staging label, then adjusts the
  ; completed file's mode before publishing it. The manager already owns the
  ; staged file; permit only that metadata update, not relabelling or execute.
  (allow .stalwart_image_manager_t .stalwart_image_staging_t
    (file (setattr)))

  ; Like protected images, staging images are opened read-only after systemd's
  ; expected writable probe. Keep that probe denied without audit noise.
  (dontaudit .init_t .stalwart_image_staging_t (file (write)))

  ; Activation may restart and observe only Stalwart and its health probe. The
  ; build labels precisely those two unit files with this dedicated type.
  (allow .stalwart_image_manager_t .particleos_stalwart_managed_unit_t
    (service (start status))))
