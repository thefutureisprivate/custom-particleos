#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
set -euo pipefail
umask 0077

_particleos_init_status=0
trap '_particleos_init_status=$?; printf "ParticleOS PostgreSQL initialization failed at line %d: %s (status %d)\n" "$LINENO" "$BASH_COMMAND" "$_particleos_init_status" >&2; exit "$_particleos_init_status"' ERR

pgdata=/var/lib/pgsql/data
marker=$pgdata/.particleos-initialized
read -r expected_major </usr/lib/particleos/postgresql/major-version
[[ $expected_major =~ ^[0-9]+$ ]]

if [[ -f $pgdata/PG_VERSION ]]; then
    read -r data_major <"$pgdata/PG_VERSION"
    if [[ $data_major != "$expected_major" ]]; then
        echo "PostgreSQL data major $data_major is incompatible with supported major $expected_major" >&2
        exit 1
    fi
else
    # Run initdb directly as the service's unprivileged postgres user. Fedora's
    # postgresql-setup wrapper also loads upgrade metadata which is not needed
    # for first-boot setup.
    /usr/bin/initdb \
        --pgdata="$pgdata" \
        --data-checksums \
        --auth-local=peer \
        --auth-host=reject
fi

read -r data_major <"$pgdata/PG_VERSION"
[[ $data_major == "$expected_major" ]]

# PostgreSQL includes this file from the generated main configuration. Keep the
# network boundary in an independently auditable, appliance-owned fragment.
mkdir -p "$pgdata/conf.d"
chmod 0700 "$pgdata/conf.d"
if ! grep -Fqx "include_dir = 'conf.d'" "$pgdata/postgresql.conf"; then
    printf "\ninclude_dir = 'conf.d'\n" >>"$pgdata/postgresql.conf"
fi

# These targets inherit postgresql_db_t from PGDATA. Do not use coreutils
# install here: its SELinux context adjustment is both unnecessary and denied
# to the deliberately confined postgresql_t setup process.
cat /usr/lib/particleos/postgresql/particleos.conf \
    >"$pgdata/conf.d/particleos.conf"
cat /usr/lib/particleos/postgresql/pg_hba.conf \
    >"$pgdata/pg_hba.conf"
chmod 0600 "$pgdata/conf.d/particleos.conf" "$pgdata/pg_hba.conf"
: >"$marker"
chmod 0600 "$marker"
