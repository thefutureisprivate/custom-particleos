#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
set -euo pipefail
umask 0077

backup_root=/var/lib/pgsql/backup
archive_name=${1:?missing WAL archive name}
restore_path=${2:?missing WAL restore path}

if [[ ! $archive_name =~ ^([0-9A-F]{24}(\.[0-9A-F]{8}\.backup)?|[0-9A-F]{8}\.history)$ ]]; then
    echo "refusing malformed PostgreSQL restore name: $archive_name" >&2
    exit 64
fi
if [[ $restore_path != pg_wal/* || $restore_path == *..* ]]; then
    echo "refusing PostgreSQL restore target outside PGDATA/pg_wal: $restore_path" >&2
    exit 64
fi
if ! /usr/bin/mountpoint --quiet "$backup_root"; then
    echo "$backup_root is not mounted" >&2
    exit 1
fi

source_path=$backup_root/wal/$archive_name
[[ -f $source_path ]] || exit 1
/usr/bin/cp --reflink=never -- "$source_path" "$restore_path"
/usr/bin/chmod 0600 "$restore_path"
