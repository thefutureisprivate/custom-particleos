# SPDX-License-Identifier: LGPL-2.1-or-later

# Stalwart's normal-mode defaults expose SMTP, implicit-TLS mail protocols,
# ManageSieve STARTTLS, and HTTPS. Its bootstrap/recovery HTTP listener on 8080
# is intentionally absent: initial administration must use a console or SSH
# tunnel. Plaintext IMAP, POP3, and submission ports are also not admitted.
set mail_tcp_conn4 {
    type ipv4_addr
    size 4096
    flags dynamic
}

set mail_tcp_conn6 {
    type ipv6_addr
    size 4096
    flags dynamic
}

chain role_prerouting_raw {
    tcp flags & (fin | syn | rst | ack) == syn tcp dport { 25, 443, 465, 993, 995, 4190 } accept
}

chain role_input {
    meta nfproto ipv4 tcp dport { 25, 443, 465, 993, 995, 4190 } ct state new add @mail_tcp_conn4 { ip saddr ct count over 64 } counter drop
    meta nfproto ipv6 tcp dport { 25, 443, 465, 993, 995, 4190 } ct state new add @mail_tcp_conn6 { ip6 saddr ct count over 64 } counter drop
    tcp dport { 25, 443, 465, 993, 995, 4190 } ct state new ct count over 2048 counter drop
    meta nfproto ipv4 tcp dport { 25, 443, 465, 993, 995, 4190 } ct state new meter mail_tcp4 size 65535 { ip saddr timeout 1m limit rate over 8/second burst 32 packets } counter drop
    meta nfproto ipv6 tcp dport { 25, 443, 465, 993, 995, 4190 } ct state new meter mail_tcp6 size 65535 { ip6 saddr timeout 1m limit rate over 8/second burst 32 packets } counter drop
    tcp dport { 25, 443, 465, 993, 995, 4190 } ct state new limit rate over 128/second burst 256 packets counter drop
    tcp dport { 25, 443, 465, 993, 995, 4190 } ct state new accept
}

chain role_output {
    meta skuid stalwart tcp dport 25 ct state new limit rate 64/second burst 128 packets accept
    meta skuid stalwart tcp dport 443 ct state new limit rate 8/second burst 16 packets accept
}
