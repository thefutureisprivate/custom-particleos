[particleos-obs]
name=ParticleOS Stalwart packages for Fedora $releasever
baseurl=https://download.opensuse.org/repositories/home:/thefutureisprivate/Fedora_44/
type=rpm-md
skip_if_unavailable=False
gpgcheck=1
gpgkey=file:///usr/share/pki/rpm-gpg/particleos-obs-pubkey.gpg
repo_gpgcheck=1
enabled=1
priority=1
includepkgs=stalwart,stalwart-particleos-host,stalwart-particleos-user,stalwart-selinux
