[secureblue-packages]
name=Secureblue packages for Fedora $releasever
baseurl=https://download.copr.fedorainfracloud.org/results/secureblue/packages/fedora-$releasever-$basearch/
type=rpm-md
skip_if_unavailable=False
gpgcheck=1
gpgkey=file:///usr/share/pki/rpm-gpg/secureblue-copr-pubkey.gpg
repo_gpgcheck=0
enabled=1
includepkgs=hardened_malloc,no_rlimit_as
