#!/usr/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
set -euo pipefail

# The Python package path follows the builder's Python version. Resolve it from
# the active mkosi installation instead of embedding a versioned filesystem path.
mkosi_obs_postoutput="$('/usr/bin/python3' -c '
from pathlib import Path
import mkosi.resources
print(Path(mkosi.resources.__file__).parent / "mkosi-obs" / "mkosi.postoutput")
')"

if [[ ! -x "$mkosi_obs_postoutput" ]]; then
    echo "mkosi-obs post-output signer is missing or not executable: $mkosi_obs_postoutput" >&2
    exit 1
fi

obs_build_wrapper=/usr/src/packages/SOURCES/custom-particleos/mkosi.scripts/particleos-obs-build
if [[ ! -x "$obs_build_wrapper" ]]; then
    echo "ParticleOS OBS build wrapper is missing or not executable: $obs_build_wrapper" >&2
    exit 1
fi

"$mkosi_obs_postoutput" "$@"

# OBS constructs the signing pass from the first pass's output files, without
# retaining the extracted SCM tree. Carry the reviewed wrapper forward with
# those files so mkosi can run it in the signing pass.
cp --reflink=auto -- "$obs_build_wrapper" "$OUTPUTDIR/particleos-obs-build"

second_stage_config="$OUTPUTDIR/mkosi.conf"
if [[ ! -f "$second_stage_config" ]]; then
    echo "mkosi-obs did not generate the second-stage configuration: $second_stage_config" >&2
    exit 1
fi

printf '%s\n' \
    '' \
    '[Content]' \
    'BuildScripts=' \
    'BuildScripts=/usr/src/packages/SOURCES/particleos-obs-build' \
    >>"$second_stage_config"
