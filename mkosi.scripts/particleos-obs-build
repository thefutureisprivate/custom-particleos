#!/usr/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
set -euo pipefail

# Keep the upstream signing implementation authoritative, then add aggregate
# metadata which its single-IMAGE_ID collector otherwise omits. Signable role
# artifacts are still handled exclusively by the upstream implementation.
mkosi_obs_build="$('/usr/bin/python3' -c '
from pathlib import Path
import mkosi.resources
print(Path(mkosi.resources.__file__).parent / "mkosi-obs" / "mkosi.build")
')"

if [[ ! -x "$mkosi_obs_build" ]]; then
    echo "mkosi-obs build signer is missing or not executable: $mkosi_obs_build" >&2
    exit 1
fi

# systemd-repart expands %M and %A from the build host during mkosi-obs's
# deferred signing pass, not from the --root= os-release supplied by the
# upstream helper. The first role in an aggregate therefore otherwise receives
# the generic usr-verity-sig label and is rejected by systemd.image_filter at
# boot. Materialize the role-specific label in each saved repart definition
# before handing the artifacts to the authoritative upstream signer.
read_os_release_value() {
    local file=$1
    local key=$2
    local line value

    line="$(grep -m1 "^${key}=" "$file")" || {
        echo "Missing $key in role OS release metadata: $file" >&2
        return 1
    }
    value=${line#*=}
    if [[ $value == \"*\" && $value == *\" ]]; then
        value=${value#\"}
        value=${value%\"}
    elif [[ $value == \'*\' && $value == *\' ]]; then
        value=${value#\'}
        value=${value%\'}
    fi
    printf '%s' "$value"
}

materialize_repart_label() {
    local role_prefix=$1
    local osrelease="$role_prefix.osrelease"
    local repart_tar="$role_prefix.repart.tar"
    local image_id image_version label workdir definition rewritten_tar

    [[ -f $osrelease ]] || {
        echo "Missing role OS release metadata: $osrelease" >&2
        return 1
    }
    [[ -f $repart_tar ]] || {
        echo "Missing role repart definitions: $repart_tar" >&2
        return 1
    }

    image_id="$(read_os_release_value "$osrelease" IMAGE_ID)"
    image_version="$(read_os_release_value "$osrelease" IMAGE_VERSION)"
    if [[ ! $image_id =~ ^[A-Za-z0-9._-]+$ || ! $image_version =~ ^[A-Za-z0-9._-]+$ ]]; then
        echo "Unsafe role identity in $osrelease: $image_id $image_version" >&2
        return 1
    fi

    label="${image_id}_${image_version}_vsig"
    if ((${#label} > 36)); then
        echo "Role verity-signature GPT label exceeds 36 characters: $label" >&2
        return 1
    fi

    workdir="$(mktemp -d /tmp/particleos-repart.XXXXXX)"
    tar -xf "$repart_tar" -C "$workdir"
    definition="$workdir/10-usr-verity-sig.conf"
    if [[ ! -f $definition ]] || ! grep -qx 'Type=usr-verity-sig' "$definition"; then
        echo "Saved repart definitions lack usr-verity-sig: $repart_tar" >&2
        return 1
    fi

    sed -i "s/^Label=.*$/Label=$label/" "$definition"
    grep -qxF "Label=$label" "$definition" || {
        echo "Failed to materialize role GPT label in $repart_tar" >&2
        return 1
    }

    rewritten_tar="$workdir/repart.tar"
    tar --sort=name --mtime="@${SOURCE_DATE_EPOCH:-0}" \
        --owner=0 --group=0 --numeric-owner \
        -cf "$rewritten_tar" -C "$workdir" \
        00-esp.conf 10-usr-verity-sig.conf 11-usr-verity.conf 12-usr.conf
    mv -- "$rewritten_tar" "$repart_tar"
    rm -r -- "$workdir"
}

shopt -s nullglob
role_roothashes=(/usr/src/packages/SOURCES/ParticleOS-*.roothash)
if ((${#role_roothashes[@]} == 0)); then
    echo "No ParticleOS role roothashes were supplied to the signing pass" >&2
    exit 1
fi

if [[ -f /usr/src/packages/SOURCES/hashes.cpio.rsasign.sig ]]; then
    for roothash in "${role_roothashes[@]}"; do
        materialize_repart_label "${roothash%.roothash}"
    done
fi

"$mkosi_obs_build" "$@"

obs_output_dir=/work/src/usr/src/packages/OTHER
if [[ ! -d "$obs_output_dir" ]]; then
    echo "OBS output directory is missing: $obs_output_dir" >&2
    exit 1
fi

copy_release_metadata() {
    local source=$1

    if [[ ! -f "$source" ]]; then
        echo "Required aggregate release metadata is missing: $source" >&2
        exit 1
    fi

    cp --reflink=auto -- "$source" "$obs_output_dir/"
}

copy_release_metadata /usr/src/packages/SOURCES/base.manifest.gz

# A non-installing aggregate can emit multiple complete roles. Upstream copies
# metadata only for mkosi's final IMAGE_ID, although it correctly signs every
# staged UKI, bootloader, and roothash. Derive each exact role prefix from the
# roothashes that entered that signing pass and require its complete update and
# audit metadata. Do not republish the bare roothash itself: upstream removes
# it deliberately so importctl cannot misidentify it as the raw disk's hash.
for roothash in "${role_roothashes[@]}"; do
    role_prefix=${roothash%.roothash}
    copy_release_metadata "$role_prefix.manifest.gz"
    copy_release_metadata "$role_prefix.osrelease"
    copy_release_metadata "$role_prefix.repart.tar"
done
