#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
set -e

# The vendor socket is pulled in statically by sockets.target, so a preset
# cannot disable it. Mask both activation units in immutable /usr instead.
ln -sfn /dev/null "$BUILDROOT/usr/lib/systemd/system/systemd-coredump.socket"
ln -sfn /dev/null "$BUILDROOT/usr/lib/systemd/system/systemd-coredump@.service"

# This VPS image never executes foreign binary formats. Mask the static loader
# and its procfs activation units so they cannot load binfmt_misc before the
# irreversible module lockdown.
ln -sfn /dev/null "$BUILDROOT/usr/lib/systemd/system/systemd-binfmt.service"
ln -sfn /dev/null "$BUILDROOT/usr/lib/systemd/system/proc-sys-fs-binfmt_misc.automount"
ln -sfn /dev/null "$BUILDROOT/usr/lib/systemd/system/proc-sys-fs-binfmt_misc.mount"

# Fedora's per-connection SSH unit wants this static target, which would create
# RSA and ECDSA host keys alongside Ed25519. The socket requires the exact
# Ed25519 generator directly, so mask the broad target without duplicating the
# vendor sshd@ unit.
ln -sfn /dev/null "$BUILDROOT/usr/lib/systemd/system/sshd-keygen.target"

# The encrypted writable root persists across A/B updates, so a newly added
# preset cannot enable first-boot provisioning in an existing /etc. Pull the
# marker-conditional wizard from immutable /usr on every slot instead. This is
# also the sole reliable enablement path while a fresh root is being populated.
mkdir -p "$BUILDROOT/usr/lib/systemd/system/multi-user.target.wants"
ln -sfn ../particleos-admin-firstboot.service \
    "$BUILDROOT/usr/lib/systemd/system/multi-user.target.wants/particleos-admin-firstboot.service"

# Fedora's generic /usr/lib/systemd rule labels systemd-bless-boot as
# init_exec_t. PID 1 consequently runs it in init_t, which may read the ESP but
# cannot rename the boot-counted UKI after a successful update. Use the
# policy's dedicated bootloader transition: bootloader_t has the narrowly
# scoped DOS filesystem permissions required to mark the new slot as good.
chroot "$BUILDROOT" /usr/bin/chcon \
    system_u:object_r:bootloader_exec_t:s0 \
    /usr/lib/systemd/systemd-bless-boot

# hostnamectl reads these mkosi-managed fields from os-release. Keep this a
# final-tree assertion because mkosi adds them after the post-install script.
grep -Fqx "IMAGE_ID=\"$IMAGE_ID\"" "$BUILDROOT/usr/lib/os-release"
if [[ -n ${IMAGE_VERSION:-} ]]; then
    grep -Fqx "IMAGE_VERSION=\"$IMAGE_VERSION\"" "$BUILDROOT/usr/lib/os-release"
fi

# polkit authentication is handled by its root socket service, not by a SUID
# process. PAM nevertheless requires its upstream unix_chkpwd helper to read
# the protected shadow database. Strip set-user-ID and set-group-ID from every
# executable file in the shipped trees, including package additions which are
# not known in advance, then restore only that audited helper. /usr is
# read-only and dm-verity authenticated; writable root and home remain nosuid.
# Starting find at each possible image filesystem keeps -xdev from skipping a
# separately mounted /usr while avoiding build-environment pseudo-filesystems.
for image_tree in \
    "$BUILDROOT/etc" \
    "$BUILDROOT/opt" \
    "$BUILDROOT/usr" \
    "$BUILDROOT/var"; do
    [[ -d "$image_tree" ]] || continue
    find "$image_tree" -xdev -type f -perm /6000 -perm /0111 \
        -exec chmod a-s -- {} +
done

readonly pam_shadow_helper="$BUILDROOT/usr/bin/unix_chkpwd"
[[ -x "$pam_shadow_helper" ]]
chmod 4755 "$pam_shadow_helper"

mapfile -t remaining_setid < <(
    for image_tree in \
        "$BUILDROOT/etc" \
        "$BUILDROOT/opt" \
        "$BUILDROOT/usr" \
        "$BUILDROOT/var"; do
        [[ -d "$image_tree" ]] || continue
        find "$image_tree" -xdev -type f -perm /6000 -perm /0111 \
            -print
    done
)
if ((${#remaining_setid[@]} != 1)) || [[ ${remaining_setid[0]:-} != "$pam_shadow_helper" ]]; then
    printf 'unexpected set-ID executable after finalization: %s\n' \
        "${remaining_setid[@]:-none}" >&2
    exit 1
fi

# Capture the entirety of /etc in /usr/share/factory/etc so we can use
# systemd-tmpfiles to symlink individual directories from it to /etc.
mkdir -p "$BUILDROOT/usr/share/factory/"
cp --archive --no-target-directory --update=none "$BUILDROOT/etc" "$BUILDROOT/usr/share/factory/etc"
ln -sr "$BUILDROOT/usr" "$BUILDROOT/usr/share/factory/usr"

# systemd-repart preserves all extended attributes when it copies this
# skeleton into the fresh writable root. Label paths relative to their future
# mount point so SELinux can enforce from the first post-switch-root exec.
root_skeleton="$BUILDROOT/usr/share/factory/root"
install -d -m 0755 \
    "$root_skeleton/etc" \
    "$root_skeleton/home" \
    "$root_skeleton/var/log/journal"
ln -sfn usr/bin "$root_skeleton/bin"
ln -sfn usr/lib "$root_skeleton/lib"
ln -sfn usr/lib64 "$root_skeleton/lib64"
ln -sfn usr/sbin "$root_skeleton/sbin"
ln -sfn /usr/share/factory/etc/selinux "$root_skeleton/etc/selinux"
chroot "$BUILDROOT" /usr/sbin/setfiles -F \
    -r /usr/share/factory/root \
    /etc/selinux/targeted/contexts/files/file_contexts \
    /usr/share/factory/root
# Generators need to traverse this as an ordinary /etc link. The immutable
# target and its policy files retain their policy-specific labels.
chroot "$BUILDROOT" /usr/bin/chcon -h system_u:object_r:etc_t:s0 \
    /usr/share/factory/root/etc/selinux
