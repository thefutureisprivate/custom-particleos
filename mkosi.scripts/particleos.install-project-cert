#!/usr/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
set -euo pipefail

certificate=/usr/src/packages/SOURCES/_projectcert.crt
destination=$BUILDROOT/usr/lib/verity.d/particleos-obs-project.crt

# Local builds are signed with their own key and do not have an OBS project
# certificate.  The production OBS configuration is matched by this file's
# presence, so a missing certificate there cannot silently reach this branch.
[[ -f $certificate ]] || exit 0
openssl x509 -in "$certificate" -noout >/dev/null
install -D -o root -g root -m 0644 "$certificate" "$destination"
