#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
set -euo pipefail

authselect select local
authselect enable-feature with-systemd-homed

# Account recovery uses systemd-homed's current explicit adoption API. Keep it
# as a hard image-build requirement.
homectl --help | grep -F "adopt PATH" >/dev/null

# run0 authenticates through polkit. Require its current root, socket-activated
# PAM helper units so the helper executable does not need a SUID transition.
for polkit_helper_unit in \
    polkit-agent-helper.socket \
    polkit-agent-helper@.service; do
    [[ -f "/usr/lib/systemd/system/$polkit_helper_unit" ]]
done

# ParticleOS follows the current upstream sysupdate unit API. Fedora 44's
# stable systemd still ships the superseded systemd-sysupdate.service/timer
# names, so make an accidental repository downgrade fail at image build time.
for current_systemd_unit in \
    systemd-sysupdate-update.service \
    systemd-sysupdate-update.timer \
    systemd-sysupdate-reboot.service \
    systemd-sysupdate-reboot.timer; do
    [[ -f "/usr/lib/systemd/system/$current_systemd_unit" ]]
done

# systemd-pull verifies OBS's signed SHA256SUMS with this exclusive project
# key. Its gpg --keyring interface requires the binary OpenPGP form, so dearmor
# the pinned repository key before mkosi's SELinux relabel pass and replace the
# generic key shipped by systemd-container.
gpg --batch --yes --dearmor \
    --output /usr/lib/systemd/import-pubring.pgp \
    /usr/lib/particleos/sysupdate-key-source/particleos-obs-pubkey.gpg
chmod 0644 /usr/lib/systemd/import-pubring.pgp

# mkosi.extra installs the final runtime preload before this script runs.
# SELinux policy compilation is memory-intensive and must use the system
# allocator inside the constrained OBS build VM. Restore the preload even if
# policy installation fails so a partially produced tree cannot lose it.
preload=/etc/ld.so.preload
preload_build_backup=/etc/ld.so.preload.particleos-build
restore_preload() {
    if [[ -f "$preload_build_backup" ]]; then
        mv "$preload_build_backup" "$preload"
    fi
}
trap restore_preload EXIT
if [[ -f "$preload" ]]; then
    mv "$preload" "$preload_build_backup"
fi

# Fail closed if a future kernel introduces an SELinux permission which the
# installed Fedora policy does not yet understand.
if ! grep -qx 'handle-unknown=deny' /etc/selinux/semanage.conf; then
    printf '\n# ParticleOS fails closed on permissions missing from policy.\nhandle-unknown=deny\n' \
        >>/etc/selinux/semanage.conf
fi

setsebool -P deny_ptrace=on
selinux_role_modules=()
if [[ $IMAGE_ID == ParticleOS-Webserver ]]; then
    selinux_role_modules+=(
        /usr/lib/particleos/selinux/particleos_web_health.cil
    )
elif [[ $IMAGE_ID == ParticleOS-Mailserver ]]; then
    selinux_role_modules+=(
        /usr/share/selinux/packages/particleos_stalwart.pp
        /usr/lib/particleos/selinux/particleos_stalwart_pull.cil
        /usr/lib/particleos/selinux/particleos_mail_health.cil
    )
fi
semodule -X 300 -i \
    /usr/lib/particleos/selinux/secureblue_harden_userns.cil \
    /usr/lib/particleos/selinux/secureblue_socket_utils.cil \
    /usr/lib/particleos/selinux/secureblue_deny_alg_sockets.cil \
    /usr/lib/particleos/selinux/secureblue_deny_ipsec_sockets.cil \
    /usr/lib/particleos/selinux/secureblue_deny_obscure_sockets.cil \
    /usr/lib/particleos/selinux/secureblue_deny_packet_radio_sockets.cil \
    /usr/lib/particleos/selinux/particleos_nosuid_daemon_transitions.cil \
    /usr/lib/particleos/selinux/particleos_runtime_symlinks.cil \
    /usr/lib/particleos/selinux/particleos_pcr_measurement.cil \
    /usr/lib/particleos/selinux/particleos_homed_login.cil \
    "${selinux_role_modules[@]}"

# /etc/selinux is an immutable factory symlink. systemd-tmpfiles consults the
# policy file contexts when it verifies that link during boot; without this
# exact symlink-only override it replaces the skeleton's etc_t label with
# selinux_config_t, which prevents confined libselinux consumers from
# resolving the policy location. Keep the target tree policy-labelled.
selinux_local_contexts=/etc/selinux/targeted/contexts/files/file_contexts.local
if [[ $IMAGE_ID == ParticleOS-Mailserver ]]; then
    # The setup service uses NoNewPrivileges. Label its appliance-owned entry
    # point with Fedora's PostgreSQL executable type so the complete one-shot,
    # including its post-init configuration writes, runs in postgresql_t.
    for postgresql_entrypoint in \
        initialize \
        enable-pitr \
        basebackup \
        archive-wal \
        restore-wal; do
        postgresql_entrypoint_context="/usr/lib/particleos/postgresql/$postgresql_entrypoint -- system_u:object_r:postgresql_exec_t:s0"
        if ! grep -Fqx "$postgresql_entrypoint_context" "$selinux_local_contexts"; then
            printf '%s\n' "$postgresql_entrypoint_context" >>"$selinux_local_contexts"
        fi
    done

    # systemd-pull reads this immutable public verification key in its confined
    # importd domain. Override the broad /usr/lib/systemd executable label with
    # Fedora's systemd configuration type.
    stalwart_import_key_context='/usr/lib/systemd/import-pubring\.pgp -- system_u:object_r:systemd_conf_t:s0'
    if ! grep -Fqx "$stalwart_import_key_context" "$selinux_local_contexts"; then
        printf '%s\n' "$stalwart_import_key_context" >>"$selinux_local_contexts"
    fi

    # The image manager may start and observe exactly the application service
    # and its bounded health probe, not arbitrary system units.
    for stalwart_managed_unit in \
        stalwart \
        particleos-mailserver-health; do
        stalwart_managed_unit_context="/usr/lib/systemd/system/$stalwart_managed_unit\\.service -- system_u:object_r:particleos_stalwart_managed_unit_t:s0"
        if ! grep -Fqx "$stalwart_managed_unit_context" "$selinux_local_contexts"; then
            printf '%s\n' "$stalwart_managed_unit_context" >>"$selinux_local_contexts"
        fi
    done
fi
selinux_factory_link_context='/etc/selinux -l system_u:object_r:etc_t:s0'
if ! grep -Fqx "$selinux_factory_link_context" "$selinux_local_contexts"; then
    printf '%s\n' "$selinux_factory_link_context" >>"$selinux_local_contexts"
fi
restore_preload
trap - EXIT

if [[ -d /etc/pam.d ]]; then
    find /etc/pam.d -mindepth 1 -exec mv {} /usr/lib/pam.d \;
    rmdir /etc/pam.d
fi

# pam_unix can validate the shadow hash exported by systemd-homed but cannot
# activate the home. Run pam_systemd_home first so it receives the password.
for pam_stack in /usr/lib/pam.d/system-auth /usr/lib/pam.d/password-auth; do
    sed --in-place \
        '/^auth[[:space:]].*pam_systemd_home\.so[[:space:]]*$/d' "$pam_stack"
    sed --in-place \
        '/^auth[[:space:]].*pam_unix\.so/i auth        sufficient                                   pam_systemd_home.so' \
        "$pam_stack"
done

# Remove obsolete entries from the PAM stack.
find /usr/lib/pam.d/ -mindepth 1 -exec sed --in-place '/pam_shells.so/d' {} \;
find /usr/lib/pam.d/ -mindepth 1 -exec sed --in-place '/pam_securetty.so/d' {} \;

# Fedora ships the current systemd-userdb SSH integration disabled as an
# example. Make its presence a build invariant instead of carrying a fallback.
ln --symbolic 20-systemd-userdb.conf.example /usr/lib/tmpfiles.d/20-systemd-userdb.conf

# Keep the installed host headless.
ln --symbolic --force multi-user.target /usr/lib/systemd/system/default.target

# The dependency graph invokes this hook only for a complete role image. Reject
# an unknown identity rather than generating a mixed or ambiguous appliance.

case "$IMAGE_ID" in
    ParticleOS-Webserver)
        particleos_role=Webserver
        particleos_role_id=webserver
        particleos_hostname='particle-web-????-????'

        # systemd creates this private runtime directory before ExecStartPre.
        # Mirror that lifecycle only for the build-time configuration test.
        install --directory --mode=0700 /run/nginx
        nginx -e stderr -t -c /usr/lib/particleos/nginx/nginx.conf
        rm --force /run/nginx/nginx.pid
        rmdir /run/nginx
        ;;
    ParticleOS-Mailserver)
        particleos_role=Mailserver
        particleos_role_id=mailserver
        particleos_hostname='particle-mail-????-????'
        ;;
    ParticleOS-Dnsserver)
        particleos_role=DNS Server
        particleos_role_id=dnsserver
        particleos_hostname='particle-dns-????-????'
        ;;
    *)
        echo "unsupported ParticleOS image ID: $IMAGE_ID" >&2
        exit 1
        ;;
esac

# The initrd may assign its own distribution fallback before switch-root, at
# which point PID 1 deliberately preserves the already configured kernel
# hostname instead of consulting the final OS's DEFAULT_HOSTNAME. Seed the
# writable root with the role pattern as well. systemd expands each question
# mark from the machine ID on first boot; later hostnamectl changes persist
# across atomic OS updates because /etc is outside the immutable /usr slot.
printf '%s\n' "$particleos_hostname" >/etc/hostname

# Give the image a distinct OS identity without changing Fedora's package
# identity. mkosi writes IMAGE_ID and IMAGE_VERSION after this script and the
# finalizer verifies them before the tree is sealed.
(
    # shellcheck source=/dev/null
    . /usr/lib/os-release
    cat >/usr/lib/os-release <<EOF
NAME="ParticleOS $particleos_role (Fedora Flavour)"
ID="$ID"
ID_LIKE="particleos-$particleos_role_id $ID"
PRETTY_NAME="ParticleOS $particleos_role/$NAME $VERSION"
FANCY_NAME="ParticleOS $particleos_role/$NAME $VERSION"
VERSION="$VERSION"
VERSION_ID="$VERSION_ID"
ANSI_COLOR="38:2:252:186:3;1;49"
ANSI_COLOR_REVERSE="48;2:252:186:3;1;30"
DEFAULT_HOSTNAME="$particleos_hostname"
HOME_URL="https://github.com/thefutureisprivate/custom-particleos/"
EOF

    cat >/usr/lib/issue <<EOF
ParticleOS $particleos_role/$NAME Flavour $VERSION
Kernel \r on an \m (\l)

EOF
)
